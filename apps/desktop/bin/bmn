#!/usr/bin/env node
// MODULE: bmn - command-line client for the BMN control socket (one connection per invocation)
import { writeSync } from 'node:fs'
import { nestedAsk, nestedWords } from './agents-team-nested.mjs'
import { AGENT_BRIEF, GLOBAL_OPTIONS, HANDOFF_OUTLINE, TERMINAL_BRIEF, USAGE } from './bmn-words.mjs'
import { COMMANDS, CliError, UsageError, call, commandUsage, parseArguments, readCredentials, requireNonEmpty } from './bmn-commands.mjs'
import { describeResult, resumeCommandRequest, takePipedField, tellRequest, usageFailure } from './bmn-results.mjs'
import { runHooks } from './bmn-hooks.mjs'
import { runHook } from './bmn-hook-runtime.mjs'

async function main(argv) {
  // Epic 72: inside a teammate's run no BMN command launches, controls or reads anything: not asks,
  // research, the judge, the roster or the app (R72-NFR4). A hook there does nothing, as it fails nowhere.
  const nested = nestedAsk()
  if (nested !== null) {
    if (argv[0] === 'hook' || (argv[0] === 'statusline' && argv[1] === 'report')) return 0
    writeSync(2, `${nestedWords(nested)}\n`)
    return 10
  }
  if (argv[0] === 'hook') return runHook(argv.slice(1)).catch(() => 0)
  // hooks reads and writes the owner's own hook files; it never opens the control socket.
  if (argv[0] === 'hooks') return runHooks(argv.slice(1))
  // Epic 83: the push policy, read through the socket; the repository's owner and default branch through the agent's own gh.
  if (argv[0] === 'policy') return (await import('./policy-cli.mjs')).runPolicyCommand(argv.slice(1), { readCredentials, call })
  // Epic 84: a run's card before the owner leaves, his grant and its uses; all decided in BMN, through the socket.
  if (argv[0] === 'grant') return (await import('./grant-cli.mjs')).runGrantCommand(argv.slice(1), { readCredentials, call })
  // Epic 77: the project's plan and board are files in the project; no socket, and it works with BMN closed.
  if (argv[0] === 'plan') return (await import('./plan-cli.mjs')).runPlanCommand(argv.slice(1))
  // Epic 60: the roster, its check and the rules master are owner files; no socket, no token.
  if (argv[0] === 'team' || argv[0] === 'roster' || argv[0] === 'rules' || argv[0] === 'context' || argv[0] === 'skills' || argv[0] === 'tools' || argv[0] === 'research' || argv[0] === 'judge') {
    const agents = await import('./agents-cli.mjs')
    try {
      // Epic 64: a web question behind the research fence; it needs no socket either, and works with BMN closed.
      if (argv[0] === 'research') return await (await import('./agents-ask.mjs')).runResearchCommand(argv.slice(1))
      // Epic 65: one checked call to the team's judge; no socket, and it works with BMN closed.
      if (argv[0] === 'judge') return await (await import('./agents-judge.mjs')).runJudgeCommand(argv.slice(1))
      if (argv[0] === 'team') return await agents.runTeam(argv.slice(1))
      if (argv[0] === 'roster') return await agents.runRoster(argv.slice(1))
      if (argv[0] === 'context') return await agents.runContext(argv.slice(1))
      if (argv[0] === 'skills') return await agents.runSkills(argv.slice(1))
      if (argv[0] === 'tools') return await agents.runTools(argv.slice(1))
      return await agents.runRules(argv.slice(1))
    } catch (error) {
      if (error instanceof agents.AgentsUsageError) return agents.usage(error.message)
      throw error
    }
  }
  // The status line's background report prints nothing and always exits 0, like a hook. Loaded only here (Story
  // 80.17), so `bmn hook`, which runs on every hook event, does not read it.
  if (argv[0] === 'statusline') {
    const statusLine = await import('./bmn-statusline.mjs')
    return argv[1] === 'report' && argv.length === 2 ? statusLine.reportStatusLine().catch(() => 0) : statusLine.statusLineCommand(argv.slice(1))
  }
  let request
  let parsed
  let command
  let positionals
  try {
    parsed = parseArguments(argv)
    ;[command, ...positionals] = parsed.positionals
    if (parsed.options.yes) throw new UsageError('--yes is only for hooks install')
    if (command === 'help' || parsed.options.help) {
      const page = command === 'help' && positionals[0] === 'agents' ? AGENT_BRIEF
        : command === 'help' && positionals[0] === 'terminal' ? TERMINAL_BRIEF
          : command !== undefined && command !== 'help' ? commandUsage(command) ?? USAGE : USAGE
      process.stdout.write(`${page}\n`)
      return 0
    }
    if (command === undefined) {
      process.stderr.write(`${USAGE}\n`)
      return 2
    }
    if (!['handoff', 'tell'].includes(command) || positionals[0] !== 'status') positionals = await takePipedField(command, parsed, positionals)
    if (command === 'tell') {
      request = tellRequest(positionals, parsed)
    } else if (command === 'handoff') {
      for (const name of Object.keys(parsed.options)) {
        if (!GLOBAL_OPTIONS.includes(name) && !['text', 'file-id', 'key', 'outline'].includes(name)) {
          throw new UsageError(`handoff does not accept --${name}`)
        }
      }
      if (parsed.options.outline) {
        // Only the outline: it opens no socket, needs no token and prepares nothing.
        if (positionals.length > 0 || Object.keys(parsed.options).some((name) => name !== 'outline')) {
          throw new UsageError('handoff --outline takes no arguments or other options')
        }
        process.stdout.write(`${HANDOFF_OUTLINE}\n`)
        return 0
      }
      if (positionals[0] === 'status') {
        if (positionals.length > 2 || parsed.options.text !== undefined ||
          parsed.options['file-id'] !== undefined || parsed.options.key !== undefined) {
          throw new UsageError('handoff status expects at most one draft id and no preparation options')
        }
        request = { method: 'state.snapshot', params: {} }
      } else {
        if (positionals.length < 1 || (parsed.literalStart === null && positionals.length !== 1) ||
          (parsed.literalStart !== null && parsed.literalStart !== 2)) {
          throw new UsageError('handoff expects a destination id and --text T, --text-file - or -- text')
        }
        if (!parsed.options.key) throw new UsageError('handoff requires --key for safe retries')
        const body = parsed.options.text ?? positionals.slice(1).join(' ')
        if (!body || (parsed.options.text !== undefined && parsed.literalStart !== null)) {
          throw new UsageError('handoff requires exactly one text source: --text T, --text-file - or -- text')
        }
        const artifactIds = parsed.options['file-id'] ?? []
        if (artifactIds.length > 10 || new Set(artifactIds).size !== artifactIds.length) {
          throw new UsageError('handoff allows at most 10 distinct --file-id values')
        }
        // The folder it runs in is where the text comes from: BMN asks that folder's provider before handing it over.
        let senderCwd
        try {
          senderCwd = process.cwd()
        } catch {
          throw new UsageError('handoff cannot read the folder it runs in; run it from an existing folder')
        }
        request = { method: 'handoff.prepare', params: {
          destinationSessionId: requireNonEmpty(positionals[0], 'destination id'),
          text: body, artifactIds, senderCwd, idempotencyKey: parsed.options.key
        } }
      }
    } else if (command === 'resume-command') {
      request = resumeCommandRequest(positionals, parsed)
    } else {
    if (!Object.hasOwn(COMMANDS, command)) throw new UsageError(`unknown command ${command}`)
    const spec = COMMANDS[command]
    for (const name of Object.keys(parsed.options)) {
      if (!GLOBAL_OPTIONS.includes(name) && !spec.options.includes(name)) {
        throw new UsageError(`${command} does not accept --${name}`)
      }
    }
    if (positionals.length !== spec.args.length) {
      const shape = spec.args.map((name) => `<${name}>`).join(' ')
      throw new UsageError(`${command} expects ${shape || 'no arguments'}`)
    }
    request = spec.build(positionals, parsed.options)
    }
  } catch (error) {
    if (error instanceof UsageError) return usageFailure(error.message)
    throw error
  }
  // A wrapper may report its resume command wherever it runs; outside BMN that is not a failure.
  if (command === 'resume-command' && parsed.options.socket === undefined &&
    !process.env.BMN_CONTROL_SOCKET && !process.env.AITERM_CONTROL_SOCKET) {
    process.stdout.write('Not inside a BMN session (BMN_CONTROL_SOCKET is unset): nothing was recorded\n')
    return 0
  }
  try {
    const { socketPath, token } = readCredentials(parsed.options)
    const result = await call(socketPath, token, request.method, request.params, request.timeoutMs)
    const output = parsed.options.json
      ? JSON.stringify(result ?? null, null, 2)
      : describeResult(command, positionals, parsed.options, result)
    process.stdout.write(`${output}\n`)
    return 0
  } catch (error) {
    if (error instanceof UsageError) return usageFailure(error.message)
    const code = error instanceof CliError ? error.code : 'IO_ERROR'
    process.stderr.write(`bmn: ${code}: ${error instanceof Error ? error.message : String(error)}\n`)
    return 1
  }
}

main(process.argv.slice(2)).then(
  (code) => {
    process.exitCode = code
  },
  (error) => {
    process.stderr.write(`bmn: IO_ERROR: ${error instanceof Error ? error.message : String(error)}\n`)
    process.exitCode = 1
  }
)
