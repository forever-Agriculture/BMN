{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Epic 100.2 manual QA brief and report, version 1",
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "texts": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } },
    "mode": { "enum": ["quick-web", "quick-bench", "session"] },
    "account": {
      "type": "object", "additionalProperties": false, "required": ["alias", "permission"],
      "properties": { "alias": { "$ref": "#/$defs/text" }, "permission": { "enum": ["test-full", "look-only"] } }
    },
    "briefCriterion": {
      "type": "object", "additionalProperties": false, "required": ["id", "description", "mandatory"],
      "properties": { "id": { "$ref": "#/$defs/text" }, "description": { "$ref": "#/$defs/text" }, "mandatory": { "type": "boolean" } }
    },
    "brief": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "revision", "target", "mode", "goal", "why", "scope", "decisions", "designs", "regression_checklist", "starting_state", "fixtures", "accounts", "time_budget_minutes", "criteria"],
      "properties": {
        "version": { "const": 1 }, "revision": { "$ref": "#/$defs/text" }, "target": { "$ref": "#/$defs/text" }, "mode": { "$ref": "#/$defs/mode" },
        "goal": { "$ref": "#/$defs/text" }, "why": { "$ref": "#/$defs/text" },
        "scope": {
          "type": "object", "additionalProperties": false, "required": ["included", "excluded"],
          "properties": { "included": { "$ref": "#/$defs/steps" }, "excluded": { "$ref": "#/$defs/texts" } }
        },
        "decisions": { "$ref": "#/$defs/texts" }, "designs": { "$ref": "#/$defs/texts" }, "regression_checklist": { "$ref": "#/$defs/texts" },
        "starting_state": { "$ref": "#/$defs/text" }, "fixtures": { "$ref": "#/$defs/texts" },
        "accounts": { "type": "array", "items": { "$ref": "#/$defs/account" } }, "time_budget_minutes": { "type": "integer", "minimum": 1 },
        "criteria": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/briefCriterion" } },
        "prior_findings": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false, "required": ["finding", "disposition"],
            "properties": { "finding": { "$ref": "#/$defs/finding" }, "disposition": { "$ref": "#/$defs/text" } }
          }
        }
      }
    },
    "criterion": {
      "type": "object", "additionalProperties": false, "required": ["id", "status", "steps", "observations", "evidence", "finding_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/text" }, "status": { "enum": ["PASS", "FAIL", "BLOCKED", "NOT RUN"] },
        "steps": { "$ref": "#/$defs/texts" }, "observations": { "$ref": "#/$defs/text" }, "evidence": { "$ref": "#/$defs/texts" }, "finding_ids": { "$ref": "#/$defs/texts" }
      }
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "category", "severity", "prerequisites", "steps", "expected", "actual", "impact", "reproduction", "evidence", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/text" }, "category": { "enum": ["functional", "slop", "usability", "accessibility", "security", "performance"] },
        "severity": { "enum": ["blocker", "major", "minor"] }, "prerequisites": { "$ref": "#/$defs/texts" }, "steps": { "$ref": "#/$defs/steps" },
        "expected": { "$ref": "#/$defs/text" }, "actual": { "$ref": "#/$defs/text" }, "impact": { "$ref": "#/$defs/text" },
        "reproduction": {
          "type": "object", "additionalProperties": false, "required": ["attempts", "observed"],
          "properties": { "attempts": { "type": "integer", "minimum": 1 }, "observed": { "type": "integer", "minimum": 1 } }
        },
        "evidence": { "$ref": "#/$defs/texts" }, "status": { "enum": ["open", "resolved"] },
        "retest": {
          "type": "object", "additionalProperties": false, "required": ["steps", "observations", "regression_gaps"],
          "properties": { "steps": { "$ref": "#/$defs/steps" }, "observations": { "$ref": "#/$defs/text" }, "regression_gaps": { "$ref": "#/$defs/texts" } }
        }
      }
    },
    "report": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "revision", "target", "mode", "account_context", "goal_check", "criteria", "findings", "debrief", "untested_areas", "verdict"],
      "properties": {
        "version": { "const": 1 }, "revision": { "$ref": "#/$defs/text" }, "target": { "$ref": "#/$defs/text" }, "mode": { "$ref": "#/$defs/mode" },
        "account_context": {
          "type": "object", "additionalProperties": false, "required": ["signed_out", "used_accounts", "observed_restrictions"],
          "properties": {
            "signed_out": { "type": "boolean" }, "observed_restrictions": { "$ref": "#/$defs/steps" },
            "used_accounts": {
              "type": "array", "items": {
                "type": "object", "additionalProperties": false, "required": ["alias", "permission", "observed_restrictions"],
                "properties": { "alias": { "$ref": "#/$defs/text" }, "permission": { "enum": ["test-full", "look-only"] }, "observed_restrictions": { "$ref": "#/$defs/steps" } }
              }
            }
          }
        },
        "goal_check": {
          "type": "object", "additionalProperties": false, "required": ["status", "execution", "steps", "observations"],
          "properties": {
            "status": { "enum": ["achieved", "partly", "not achieved", "uncertain"] }, "execution": { "enum": ["started", "not started"] },
            "steps": { "$ref": "#/$defs/texts" }, "observations": { "$ref": "#/$defs/text" }, "question": { "$ref": "#/$defs/text" }
          }
        },
        "criteria": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/criterion" } },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "debrief": {
          "type": "object", "additionalProperties": false, "required": ["confidence", "summary", "notes"],
          "properties": { "confidence": { "enum": ["high", "medium", "low"] }, "summary": { "$ref": "#/$defs/text" }, "notes": { "$ref": "#/$defs/texts" } }
        },
        "untested_areas": { "$ref": "#/$defs/texts" }, "verdict": { "enum": ["GO", "GO WITH ISSUES", "NO-GO"] },
        "audit_summary": {
          "type": "object", "additionalProperties": false, "required": ["complete", "observed_traffic", "gaps"],
          "properties": { "complete": { "type": "boolean" }, "observed_traffic": { "$ref": "#/$defs/texts" }, "gaps": { "$ref": "#/$defs/texts" } }
        }
      }
    }
  }
}
